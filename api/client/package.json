{
  "name": "@jorgetroya80/mad-transit-client",
  "version": "0.0.0",
  "description": "Typed client for the Mad Transit public API",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgetroya80/mad-transit.git",
    "directory": "api/client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "cp ../build/openapi/mad-transit.json openapi.json && openapi-ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  }
}
