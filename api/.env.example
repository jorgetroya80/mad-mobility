# Copy to .env.local (ignored by git) and fill in. Read by bootRun and `docker run --env-file`.
# Use EMT_EMAIL + EMT_PASSWORD, or EMT_CLIENT_ID + EMT_PASS_KEY (registered app).
# No quotes: values are read literally by Spring (properties format) and by `docker run --env-file`.
EMT_EMAIL=
EMT_PASSWORD=
# EMT_CLIENT_ID=
# EMT_PASS_KEY=
# EMT_BASE_URL=https://openapi.emtmadrid.es
# CORS_ALLOWED_ORIGINS=http://localhost:5173
